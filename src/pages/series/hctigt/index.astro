---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { publishedPosts } from '../../../lib/posts';
const posts = (await publishedPosts()).filter((post) => post.data.series === 'hctigt');
---
<BaseLayout title="Hill Climb Till It's Go Time" description="An ongoing series on AI interpretability and making progress through empirical research.">
  <header class="page-header">
    <p class="eyebrow">Ongoing series · HCTiGT</p>
    <h1>Hill Climb Till<br /><em>It's Go Time</em></h1>
    <p>An ongoing series on AI interpretability, experiments, and learning by doing.</p>
  </header>
  <section class="section-block"><h2>Entries</h2><PostList posts={posts} /></section>
</BaseLayout>
